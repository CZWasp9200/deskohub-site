engine biome(1.0)
language js(typescript, jsx)

// `@/env` carries the server environment schema and its administrator,
// igloohome, and admin API dependencies. Browser modules read the
// browser-visible environment from `@/client-env` so that graph stays out of
// client bundles, whether loaded statically, with `import()`, or `require`.
// Type-only imports and re-exports are erased and add no client code.
file($name, $body) where {
  $name <: r".*apps/deskohub-workspace/.*\.(?:ts|tsx)$",
  or {
    $name <: r".*apps/deskohub-workspace/instrumentation-client\.ts$",
    and {
      $body <: r"(?s).*use client.*",
      $body <: contains JsDirective() as $directive where {
        $directive <: r"(?s)^['\"]use client['\"];?$"
      }
    }
  },
  $body <: contains bubble {
    or {
      JsModuleSource() as $span where {
        $span <: r"^['\"](?:@/env|(?:\.\.?/)+env)['\"]$",
        not $span <: within JsImport() as $import where {
          $import <: r"(?s)^import\s+type\s.*"
        },
        not $span <: within JsExport() as $export where {
          $export <: r"(?s)^export\s+type\s.*"
        }
      },
      JsImportCallExpression() as $span where {
        $span <: r"(?s)^import\s*\(\s*['\"](?:@/env|(?:\.\.?/)+env)['\"].*"
      },
      JsCallExpression() as $span where {
        $span <: r"(?s)^require\s*\(\s*['\"](?:@/env|(?:\.\.?/)+env)['\"].*"
      }
    } where {
      register_diagnostic(
        span = $span,
        message = "Browser modules must read the browser-visible environment from `@/client-env`, not the server `@/env`.",
        severity = "error"
      )
    }
  }
}
