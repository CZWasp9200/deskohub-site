engine biome(1.0)
language js(typescript, jsx)

// Test code builds addresses with `testEmailAddress` (on the EMAIL_TEST_DOMAIN
// constant, so mail routes to Console) or `resendSimulatorAddress` from
// `@deskohub/email/testing`; a hand-written address could reach a real inbox.
// It flags addresses in string, template, and JSX literals, including `+`
// chains of literals and `@` written as \x40, \u0040, \u{40}, &#64;,
// &#x40;, &commat;, or %40. URL credentials (`user:secret@host`), hosts
// followed by a path, and asset names such as `icon@2x.png` are not addresses.
// It is a guardrail, not a security boundary: it does not evaluate
// `[...].join("@")`, `String.fromCharCode`, or other computed values.
file($name, $body) where {
  $name <: or {
    r".*\.(?:test|test-utils|test-fixture|pw|mock|spec)\.(?:[cm]?js|jsx|ts|tsx)$",
    r".*/(?:e2e|testing|__tests__|__fixtures__|_fixtures|fixtures|\(testing-only\))/.*\.(?:[cm]?js|jsx|ts|tsx)$",
    r".*(?:-fixture|/fixtures?)\.(?:[cm]?js|jsx|ts|tsx)$",
    r".*apps/deskohub-workspace/scripts/(?:account-visual|account-sticky)/.*\.(?:ts|tsx)$",
    r".*apps/deskohub-workspace/scripts/posthog-identity-browser\.ts$"
  },
  $body <: contains bubble {
    or {
      or {
        JsStringLiteralExpression() as $literal,
        JsTemplateChunkElement() as $literal,
        JsxString() as $literal,
        JsxText() as $literal
      } where {
        $literal <: or {
          r"(?s)(?:.*[\s\"'`<>(\[{,;=?&])?(?:mailto:)?[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}(?:[^A-Za-z0-9.\-/].*)?",
          // Escaped, entity-encoded, or URL-encoded `@` after a word boundary.
          r"(?s)(?:.*[\s\"'`<>(\[{,;=?&])?[A-Za-z0-9._+-]+(?:\\x40|\\u0040|\\u\{40\}|&#0*64;|&#[xX]0*40;|&commat;|%40)[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}(?:[^A-Za-z0-9.\-/].*)?"
        }
      },
      // `${localPart}@example.com` writes the domain by hand; a URL host after
      // interpolated credentials (`${password}@example.com/app.js`) does not.
      JsTemplateChunkElement() as $literal where {
        $literal <: r"(?s)@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}(?:[^A-Za-z0-9.\-/:?#].*)?"
      },
      // A literal holding only `@example.com`, as in `"ada" + "@example.com"`.
      JsStringLiteralExpression() as $literal where {
        $literal <: r"(?s)[\"'`]@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}(?:[^A-Za-z0-9.\-/:?#][^\"'`]*)?[\"'`]"
      },
      // A `+` chain of literals that spells an address across its parts.
      `$left + $right` as $literal where {
        $literal <: r"(?s).*[A-Za-z0-9._%-](?:[\"'`]\s*\+\s*[\"'`])?@(?:[\"'`]\s*\+\s*[\"'`])?[A-Za-z0-9-](?:[A-Za-z0-9-]|[\"'`]\s*\+\s*[\"'`])*(?:(?:[\"'`]\s*\+\s*[\"'`])?\.(?:[\"'`]\s*\+\s*[\"'`])?[A-Za-z0-9-](?:[A-Za-z0-9-]|[\"'`]\s*\+\s*[\"'`])*)*(?:[\"'`]\s*\+\s*[\"'`])?\.(?:[\"'`]\s*\+\s*[\"'`])?[A-Za-z](?:[A-Za-z]|[\"'`]\s*\+\s*[\"'`])*[A-Za-z](?:[\"'`](?:\s*\+\s*(?:[^\"'`\s]|[\"'`](?:[\"'`]|[^A-Za-z0-9.\-/:?#])).*)?|[^A-Za-z0-9.\-/:?#\"'`].*)"
      }
    } where {
      // Asset names such as `icon@2x.png` or `icon%402x.png` are not addresses.
      $literal <: not r"(?s).*(?:@|(?:\\x40|\\u0040|\\u\{40\}|&#0*64;|&#[xX]0*40;|&commat;|%40))(?:[\"'`]\s*\+\s*[\"'`])?[A-Za-z0-9-]+(?:(?:[\"'`]\s*\+\s*[\"'`])?\.(?:[\"'`]\s*\+\s*[\"'`])?[A-Za-z0-9-]+)*(?:[\"'`]\s*\+\s*[\"'`])?\.(?:[\"'`]\s*\+\s*[\"'`])?(?:png|jpe?g|gif|svg|webp|avif|ico|bmp|css|js|mjs|cjs|ts|tsx|json|html?|txt|pdf|woff2?|ttf|map|mp4|webm)(?:[^A-Za-z0-9.\-].*)?",
      register_diagnostic(
        span = $literal,
        message = "Build test email addresses with testEmailAddress or resendSimulatorAddress from @deskohub/email/testing instead of writing them.",
        severity = "error"
      )
    }
  }
}
